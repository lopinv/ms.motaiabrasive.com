---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CtaBand from '../../../components/CtaBand.astro';
import FaqItem from '../../../components/FaqItem.astro';
import StickyQuote from '../../../components/StickyQuote.astro';
import RelatedArticles from '../../../components/RelatedArticles.astro';
import { models } from '../../../data/models';
import { productCategories } from '../../../data/site';

export function getStaticPaths() {
  return models.map((model) => ({ params: { slug: model.slug }, props: { model } }));
}

const { model } = Astro.props;
const category = productCategories.find((item) => item.slug === model.categorySlug)!;
const siblings = models.filter((item) => item.categorySlug === model.categorySlug && item.slug !== model.slug);
const breadcrumbs = [
  { name: 'Laman utama', href: '/' },
  { name: 'Produk', href: '/products' },
  { name: category.name, href: `/products/${category.slug}` },
  { name: model.sizeLabel, href: `/products/models/${model.slug}` },
];

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: model.name,
  description: model.summary,
  image: new URL(model.image, Astro.site).href,
  sku: model.slug.toUpperCase(),
  brand: { '@type': 'Brand', name: 'MoTai Abrasives' },
  category: model.family,
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Saiz', value: model.sizeAr },
    { '@type': 'PropertyValue', name: 'Gred', value: model.gritRange.join(', ') },
    { '@type': 'PropertyValue', name: 'Jenis tapak', value: model.backing },
    { '@type': 'PropertyValue', name: 'Cara pelekatan', value: model.attachment },
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: model.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title={`${model.name} | MoTai bahan amplas`}
  description={`${model.name} MoTai: ${model.gritRange.length} gred tersedia, spesifikasi jelas dan bahan amplas borong. Minta sebut harga untuk saiz dan gred anda.`}
  image={model.image}
  type="product"
  breadcrumbs={breadcrumbs}
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="product-hero">
    <div class="container product-hero__grid">
      <div class="product-hero__content">
        <span class="eyebrow">{model.family} · MoTai</span>
        <h1>{model.name}</h1>
        <p>{model.summary}</p>
        <ul class="hero__trust">
          <li>{model.gritRange.length} gred</li>
          <li>Spesifikasi disahkan sebelum pengeluaran</li>
          <li>Bekalan borong</li>
        </ul>
        <div class="hero__actions">
          <a class="button button--accent" href={`/quote?product=${model.slug}`}>Minta Sebut Harga</a>
          <a class="button button--ghost" href="#grit">Lihat Gred</a>
        </div>
      </div>
      <figure class="product-hero__media">
        <img src={model.image} alt={model.imageAlt} width="680" height="510" />
        <figcaption>Kuantiti pesanan minimum dan terma komersial disahkan dalam sebut harga.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--light product-overview">
    <div class="container product-overview__grid">
      <div class="product-overview__main">
        <div class="content-block">
          <span class="eyebrow">Bila saiz ini sesuai?</span>
          <h2>Satu saiz khusus, julah gred yang tersedia merangkumi kitaran penghabisan</h2>
          <p>
            {model.summary} Pemilihan saiz yang tepat bermula dari sepadan dengan siri mesin dan
            cara pelekatan, kemudian kami menetapkan gred mengikut sifat bahan pembuatan dan
            hasil penghabisan yang diingini.
          </p>
          <ul class="check-list check-list--large">
            <li>Saiz: <strong>{model.sizeAr}</strong></li>
            <li>Jenis tapak: {model.backing}</li>
            <li>Cara pelekatan: {model.attachment}</li>
          </ul>
        </div>

        <div class="content-block" id="grit">
          <span class="eyebrow">Gred</span>
          <h2>Gred mana yang sesuai dengan fasa anda?</h2>
          <p>
            Kami senaraikan {model.gritRange.length} gred yang tersedia untuk saiz ini. Pemilihan
            yang tepat bergantung pada bahan pembuatan, tekanan dan halaju suapan, jadi kami menghantar
            sampel dahulu sebelum kelulusan kuantiti apabila diperlukan.
          </p>
          <ul class="grit-grid" aria-label="Gred yang tersedia">
            {model.gritRange.map((grit) => <li>{grit}</li>)}
          </ul>
          <div class="table-wrap">
            <table>
              <caption>Ringkasan spesifikasi rujukan {model.name}. Spesifikasi akhir diteliti bersama pembeli.</caption>
              <thead><tr><th>Item</th><th>Perincian</th></tr></thead>
              <tbody>
                <tr><th scope="row">Saiz</th><td>{model.sizeAr}</td></tr>
                <tr><th scope="row">Gred</th><td>{model.gritRange.join(', ')}</td></tr>
                <tr><th scope="row">Jenis tapak</th><td>{model.backing}</td></tr>
                <tr><th scope="row">Cara pelekatan</th><td>{model.attachment}</td></tr>
                <tr><th scope="row">Kumpulan produk</th><td>{model.family}</td></tr>
              </tbody>
            </table>
          </div>
          <p class="fine-print">
            Harga bergantung pada gred, kuantiti, pembungkusan dan lokasi penghantaran. Spesifikasi
            terperinci dan kos dihantar bersama sebut harga.
          </p>
        </div>

        <div class="content-block">
          <span class="eyebrow">Titik perlu diberi perhatian</span>
          <h2>Tiga perkara yang menentukan kejayaan bekalan</h2>
          <ol class="selection-steps">
            {model.notes.map((note) => <li><p>{note}</p></li>)}
          </ol>
        </div>

        <div class="content-block">
          <span class="eyebrow">Soalan lazim</span>
          <h2>Soalan tentang {model.name}</h2>
          <div class="faq-list">
            {model.faq.map((item) => <FaqItem question={item.q} answer={item.a} />)}
          </div>
        </div>
      </div>

      <aside class="product-sidebar">
        <StickyQuote product={model.name} />
        <div class="sidebar-card">
          <h3>Maklumat berguna untuk pesanan</h3>
          <ul class="check-list">
            <li>Saiz: {model.sizeAr}</li>
            <li>Gred yang diminta</li>
            <li>Kuantiti dan kekerapan pesanan</li>
            <li>Lokasi penghantaran</li>
          </ul>
          <a class="text-link" href="/resources/abrasive-grit-guide">Lihat panduan gred <span>→</span></a>
        </div>
        {
          siblings.length > 0 && (
            <div class="sidebar-card sidebar-card--soft">
              <h3>Saiz lain dalam kumpulan sama</h3>
              <ul class="plain-links">
                {siblings.map((item) => (
                  <li><a href={`/products/models/${item.slug}`}>{item.name} →</a></li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div class="section-heading section-heading--split">
        <div>
          <span class="eyebrow">Konteks pembelian</span>
          <h2>Bandingkan saiz sebelum kelulusan pesanan</h2>
        </div>
        <a class="button button--outline" href={`/products/${category.slug}`}>Halaman {category.name}</a>
      </div>
      <div class="related-grid">
        <a class="related-card" href={`/products/${category.slug}`}>
          <img src={category.image} alt="" width="320" height="220" loading="lazy" />
          <div>
            <h3>{category.name}</h3>
            <p>{category.description}</p>
            <span>Lihat katalog kumpulan →</span>
          </div>
        </a>
        <a class="related-card" href="/resources/abrasive-grit-guide">
          <img src="/images/grit-reference.png" alt="" width="320" height="220" loading="lazy" />
          <div><h3>Panduan Pemilihan Gred</h3><p>Jadual rujukan yang mengaitkan gred dengan kerja penghabisan asas.</p><span>Baca panduan →</span></div>
        </a>
        <a class="related-card" href="/quality">
          <img src="/images/converting.jpg" alt="" width="320" height="220" loading="lazy" />
          <div><h3>Jaminan kualiti</h3><p>Fasa pengesahan spesifikasi dan pemeriksaan sampel sebelum beralih ke pesanan pengeluaran.</p><span>Ketahui tentang pemeriksaan →</span></div>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <RelatedArticles productFamily={model.categorySlug} />
    </div>
  </section>

  <CtaBand
    title={`Minta sebut harga untuk ${model.name}`}
    text="Hantar saiz, gred, kuantiti dan lokasi penghantaran. Kami meninjau spesifikasi dan menyediakan sebut harga komersial yang jelas untuk anda."
  />
</Layout>
