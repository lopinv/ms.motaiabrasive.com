---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqItem from '../../components/FaqItem.astro';
import StickyQuote from '../../components/StickyQuote.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { productCategories } from '../../data/site';
import { getModelByCategory } from '../../data/models';

export function getStaticPaths() {
  return productCategories.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const related = productCategories.filter((item) => item.slug !== product.slug).slice(0, 3);
const categoryModels = getModelByCategory(product.slug);
const breadcrumbs = [
  { name: 'Laman utama', href: '/' },
  { name: 'Produk', href: '/products' },
  { name: product.name, href: `/products/${product.slug}` },
];

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  image: new URL(product.image, Astro.site).href,
  brand: { '@type': 'Brand', name: 'MoTai Abrasives' },
  category: 'Bahan Ampelas',
  additionalProperty: product.specs.map(([name, value]) => ({
    '@type': 'PropertyValue',
    name,
    value,
  })),
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: product.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title={`${product.name} | Spesifikasi dan bekalan dari MoTai`}
  description={`${product.name} MoTai: aplikasi, spesifikasi rujukan, pilihan yang tersedia dan soalan pembeli untuk memilih produk yang sesuai untuk pesanan anda.`}
  image={product.image}
  type="product"
  breadcrumbs={breadcrumbs}
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="product-hero">
    <div class="container product-hero__grid">
      <div class="product-hero__content">
        <span class="eyebrow">Kumpulan produk MoTai</span>
        <h1>{product.title}</h1>
        <p>{product.description}</p>
        <ul class="hero__trust">
          <li>Spesifikasi disahkan sebelum pengeluaran</li>
          <li>Sokongan sampel mengikut permintaan</li>
          <li>Pilihan OEM</li>
        </ul>
        <div class="hero__actions">
          <a class="button button--accent" href={`/quote?product=${product.slug}`}>Minta Sebut Harga</a>
          <a class="button button--ghost" href="#specs">Lihat Spesifikasi</a>
        </div>
      </div>
      <figure class="product-hero__media">
        <img src={product.image} alt={`${product.name} dari kilang MoTai`} width="680" height="510" />
        <figcaption>Produk boleh dibekalkan dalam pembungkusan komersial atau jenama sendiri setelah spesifikasi disahkan.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--light product-overview">
    <div class="container product-overview__grid">
      <div class="product-overview__main">
        <div class="content-block">
          <span class="eyebrow">Bila menggunakan produk ini?</span>
          <h2>Sesuai untuk aplikasi penghabisan dan pengampelasan</h2>
          <p>
            {product.name} melayani projek yang memerlukan hasil boleh diulang pada fasa penghabisan.
            Pemilihan produk bermula dari menentukan bahan pembuatan, mesin dan gred yang
            diperlukan, kemudian kami menala spesifikasi supaya sepadan dengan kaedah operasi dan
            kuantiti yang dijangka.
          </p>
          <ul class="check-list check-list--large">
            <li>Pilih bentuk dan saiz yang sepadan dengan mesin dan cara pelekatan.</li>
            <li>Tetapkan gred atau jenis bahan mengikut fasa pengampelasan dan penghabisan.</li>
            <li>Tinjau jenis asas dan kesesuaian dengan peralatan pembeli.</li>
            <li>Kelulusan kuantiti dan pembungkusan sebelum beralih ke pesanan pengeluaran.</li>
          </ul>
        </div>

        <div class="content-block" id="specs">
          <span class="eyebrow">Spesifikasi rujukan</span>
          <h2>Maklumat teknikal untuk mempersedia permintaan sebut harga</h2>
          <div class="table-wrap">
            <table>
              <caption>Spesifikasi am {product.name}. Spesifikasi akhir diteliti bersama pembeli.</caption>
              <thead><tr><th>Item</th><th>Perincian</th></tr></thead>
              <tbody>
                {product.specs.map(([name, value]) => <tr><th scope="row">{name}</th><td>{value}</td></tr>)}
              </tbody>
            </table>
          </div>
          <p class="fine-print">
            Permintaan akhir berbeza mengikut aplikasi, mesin dan kuantiti. Hubungi kami untuk
            mengesahkan spesifikasi tepat dan status bekalan sebelum kelulusan kuantiti.
          </p>
        </div>

        <div class="content-block">
          <span class="eyebrow">Saiz tersedia</span>
          <h2>Pilih saiz yang sepadan dengan mesin anda</h2>
          <p>
            Setiap saiz menyatakan gred yang tersedia, jenis asas dan cara pelekatan, supaya anda
            boleh mempersedia permintaan sebut harga tanpa andaian.
          </p>
          <div class="model-list">
            {
              categoryModels.length ? (
                categoryModels.map((model) => (
                  <a class="model-list__item" href={`/products/models/${model.slug}`}>
                    <img src={model.image} alt="" width="96" height="72" loading="lazy" />
                    <span>
                      <strong>{model.name}</strong>
                      <small>{model.gritRange.length} gred · {model.backing}</small>
                    </span>
                    <span class="model-list__arrow">→</span>
                  </a>
                ))
              ) : (
                <p class="model-list__empty">
                  Kumpulan produk ini dibekalkan mengikut spesifikasi yang diminta — hantar saiz
                  dan gred yang sepadan dengan mesin anda melalui sebut harga, kami mengesahkan
                  status bekalan sebelum pengeluaran.
                </p>
              )
            }
          </div>
        </div>

        <div class="content-block">
          <span class="eyebrow">Soalan lazim</span>
          <h2>Soalan yang biasa ditanya pembeli bahan amplas</h2>
          <div class="faq-list">
            {product.faq.map((item) => <FaqItem question={item.q} answer={item.a} />)}
          </div>
        </div>
      </div>

      <aside class="product-sidebar">
        <StickyQuote product={product.name} />
        <div class="sidebar-card">
          <h3>Maklumat berguna untuk pesanan</h3>
          <ul class="check-list">
            <li>Jenis produk dan saiz atau diameter</li>
            <li>Gred atau jenis partikel</li>
            <li>Mesin dan cara pelekatan</li>
            <li>Kuantiti dan lokasi penghantaran</li>
          </ul>
          <a class="text-link" href="/resources/abrasive-grit-guide">Lihat panduan gred <span>→</span></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div class="section-heading section-heading--split">
        <div>
          <span class="eyebrow">Produk berkaitan</span>
          <h2>Produk-produk ini mungkin sesuai untuk pesanan anda</h2>
        </div>
        <a class="button button--outline" href="/products">Lihat semua produk</a>
      </div>
      <div class="related-grid">
        {
          related.map((item) => (
            <a class="related-card" href={`/products/${item.slug}`}>
              <img src={item.image} alt="" width="320" height="220" loading="lazy" />
              <div><h3>{item.name}</h3><p>{item.description}</p><span>Lihat produk →</span></div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <RelatedArticles productFamily={product.slug} />
    </div>
  </section>

  <CtaBand
    title={`Anda perlukan sebut harga untuk ${product.name}?`}
    text="Hantar saiz, kuantiti dan jenis aplikasi. Kami meninjau spesifikasi dan menyediakan sebut harga yang jelas untuk anda."
  />
</Layout>
