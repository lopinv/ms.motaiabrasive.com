---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../data/site';
---

<Layout
  title="Hubungi Kilang MoTai Bahan amplas | Minta Sebut Harga"
  description="Hubung terus dengan pasukan MoTai bahan amplas di Hubei, China melalui emel atau WhatsApp, atau gunakan borang pertanyaan untuk meminta sebut harga."
  image="/images/factory.jpg"
>
  <section class="page-hero page-hero--contact">
    <div class="container page-hero__inner">
      <span class="eyebrow eyebrow--light">Hubungi kami</span>
      <h1>Mula pesanan melalui saluran yang paling sesuai untuk anda</h1>
      <p>
        Untuk pertanyaan pantas, gunakan WhatsApp. Bagi pesanan yang memerlukan spesifikasi,
        kuantiti dan sebut harga, gunakan borang pertanyaan khusus untuk menghantar semua
        perincian kepada kami dalam satu mesej.
      </p>
    </div>
  </section>

  <section class="section section--light">
    <div class="container contact-layout">
      <div class="contact-methods">
        <article class="contact-card contact-card--primary">
          <span class="eyebrow eyebrow--light">Paling pantas</span>
          <h2>Sembang WhatsApp</h2>
          <p>Hantar gambar atau kod produk, nyatakan kuantiti dan lokasi penghantaran. Kami menggunakan perbualan untuk mengesahkan spesifikasi sebelum menghantar sebut harga.</p>
          <a class="button button--accent" href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener nofollow">Buka WhatsApp</a>
        </article>
        <article class="contact-card">
          <span class="eyebrow">Hubungan rasmi</span>
          <h2>Emel</h2>
          <p>Sesuai untuk pesanan OEM, bekalan berkala, penghantaran fail logo dan spesifikasi.</p>
          <a class="button button--outline" href={`mailto:${SITE.email}`} dir="ltr">{SITE.email}</a>
        </article>
        <article class="contact-card">
          <span class="eyebrow">Telefon</span>
          <h2>Panggil terus</h2>
          <p>Perbincangan perincian komersial atau susunan lawatan kilang setelah mengesahkan temu janji.</p>
          <a class="button button--outline" href={`tel:${SITE.phone.replace(/\s/g, '')}`} dir="ltr">{SITE.phone}</a>
        </article>
      </div>

      <div class="contact-details">
        <span class="eyebrow">Maklumat kilang</span>
        <h2>MoTai bahan amplas</h2>
        <dl class="spec-dl">
          <div><dt>Syarikat</dt><dd dir="ltr">{SITE.legalName}</dd></div>
          <div><dt>Alamat</dt><dd>{SITE.addressAr}</dd></div>
          <div><dt>Waktu maklum balas</dt><dd>Isnin–Sabtu, mengikut zon waktu kilang</dd></div>
          <div><dt>Bahasa</dt><dd>Bahasa Melayu, Inggeris, Cina</dd></div>
        </dl>
        <p class="fine-print">Kami menerima pertanyaan sepanjang laluan bekalan yang sebenar. Untuk mengelak lewat maklum balas semasa cuti perayaan, gunakan WhatsApp dengan tajuk topik.</p>
      </div>
    </div>
  </section>

  <CtaBand title="Sedia untuk meminta sebut harga?" text="Siapkan jenis produk, saiz, kuantiti dan lokasi penghantaran, kami akan menyempurnakan perincian selebihnya bersama anda." />
</Layout>
