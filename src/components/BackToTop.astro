---
/**
 * Butang kembali ke atas — dipaparkan semasa skrol, serasi LTR, menghormati prefers-reduced-motion.
 */
---

<button class="back-to-top" type="button" data-back-to-top aria-label="Kembali ke atas halaman" hidden>
  <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
    <path
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 19V5m-7 7 7-7 7 7"
    ></path>
  </svg>
</button>

<style>
  .back-to-top {
    position: fixed;
    inset-block-end: 24px;
    inset-inline-start: 24px;
    z-index: 150;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--card);
    color: var(--ink-2);
    box-shadow: var(--sh-2);
    cursor: pointer;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.2s var(--ease-fast), transform 0.2s var(--ease-fast),
      background 0.15s var(--ease-fast), color 0.15s var(--ease-fast),
      border-color 0.15s var(--ease-fast);
  }

  .back-to-top.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .back-to-top:hover {
    border-color: var(--brand-500);
    background: var(--brand-100);
    color: var(--brand-700);
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
      transform: none;
    }

    .back-to-top.is-visible {
      transform: none;
    }
  }

  @media (max-width: 620px) {
    .back-to-top {
      inset-block-end: 16px;
      inset-inline-start: 16px;
      width: 40px;
      height: 40px;
    }
  }
</style>

<script>
  // Balik ke atas: paparkan apabila skrol melebihi 600px; klik untuk naik lancar (sertika jika reduced-motion)
  const btn = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
  if (btn) {
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const update = () => {
      const show = window.scrollY > 600;
      btn.hidden = !show;
      btn.classList.toggle('is-visible', show);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: motion.matches ? 'instant' : 'smooth' });
    });
  }
</script>