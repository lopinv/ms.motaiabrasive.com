---
import { SITE } from '../data/site';

export interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  breadcrumbs?: { name: string; href: string }[];
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  image = '/images/og-cover.svg',
  type = 'website',
  noindex = false,
  jsonLd = [],
  breadcrumbs = [],
} = Astro.props;

const canonical = new URL(canonicalPath, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.legalName,
  alternateName: SITE.nameAr,
  url: SITE.url,
  email: SITE.email,
  telephone: SITE.phone,
  logo: `${SITE.url}/images/logo.svg`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'No. 88 Yuli Avenue',
    addressLocality: 'Junshui Town, Tongcheng County, Xianning',
    addressRegion: 'Hubei',
    addressCountry: 'CN',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    telephone: SITE.phone,
    email: SITE.email,
    availableLanguage: ['ms', 'en', 'zh'],
  },
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: SITE.nameAr,
  description: 'Laman web rasmi kilang bahan amplas MoTai, perkhidmatan kepada pembeli industri.',
  inLanguage: 'ms',
  publisher: { '@id': `${SITE.url}/#organization` },
};

const breadcrumbSchema = breadcrumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: new URL(item.href, SITE.url).href,
      })),
    }
  : null;

const graph = [organization, website, breadcrumbSchema, ...jsonLd].filter(Boolean);
---

<!doctype html>
<html lang="ms" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#2e566f" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ms" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {!noindex && <meta name="robots" content="index,follow,max-image-preview:large" />}

    <meta property="og:locale" content="ms_MY" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.nameAr} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/icon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Perf: preconnect to remote image CDN (product/scene images hot-linked) -->
    <link rel="preconnect" href="https://www.motaiabrasive.com" crossorigin />
    <!-- Fonts: non-blocking print trick + display=swap so text paints first -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      />
    </noscript>
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <!-- GA4 analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SLN397942Q"></script>
    <script>
      const dataLayer: unknown[] = ((window as any).dataLayer = (window as any).dataLayer || []);
      function gtag(...args: unknown[]) {
        dataLayer.push(args);
      }
      gtag('js', new Date());
      gtag('config', 'G-SLN397942Q', { anonymize_ip: true });
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Teruskan ke kandungan utama</a>
    <slot />
    <script>
      // Animasi masuk semasa skrol
      const reveals = document.querySelectorAll('[data-reveal]');
      if (reveals.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        reveals.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
